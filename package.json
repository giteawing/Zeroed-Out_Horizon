{
  "name": "zeroed-out-horizon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "«Империя обнуленного горизонта» — браузерный симулятор нефтяной империи с непрерывной добычей и управлением потоками",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "balance": "vitest run tests/balance.test.ts tests/balance-profiles.test.ts --reporter=verbose",
    "balance:report": "tsx scripts/balance-report.ts",
    "balance:auto": "tsx scripts/auto-balance.ts",
    "art": "node scripts/generate-icons.mjs && node scripts/generate-scenes.mjs",
    "art:force": "node scripts/generate-icons.mjs --force && node scripts/generate-scenes.mjs",
    "lint:strings": "vitest run tests/content.test.ts -t \"зашитых русских строк\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
